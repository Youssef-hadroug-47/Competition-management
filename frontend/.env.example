# Copy this file to .env and fill in your backend's address.
# Nothing here is read by the browser directly — `npm run build:config`
# reads it at build time and writes public/js/config.js, which IS safe
# to ship to the browser (it only ever contains a base URL, never secrets).

API_HOST=localhost
API_PORT=4000
# Leave empty if your API is mounted at the root ("/"). Set to "/api" etc.
# if the Express router in index.js is mounted under a prefix.
API_BASE_PATH=

# Port the static frontend itself is served on (used by `npm start`).
APP_PORT=5173
