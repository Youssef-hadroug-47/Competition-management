{
  "name": "tournament-manager",
  "version": "1.0.0",
  "description": "REST API for creating and managing sports tournaments",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "start:api": "npm start",
    "start:ui": "cd frontend; npm start", 
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,UI\" -c \"cyan,magenta\" \"npm run start:api\" \"npm run start:ui\""
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrency": "^0.1.4"
  }
}
