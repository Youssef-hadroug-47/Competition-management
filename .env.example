PORT=3000
JWT_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://{{username}}:{{password}}@{{host}}:{{port}}/tournament_manager
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=10000
PERFORMANCE_LOGGING=false
# Comma-separated browser origins. Local frontend origins default to ports 5173.
# In production include FRONTEND_ORIGIN here when Google OAuth is enabled.
CORS_ORIGINS=
